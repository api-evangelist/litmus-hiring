{
  "opencollection": "1.0.0",
  "info": {
    "name": "Litmus Hiring REST Invites Submissions API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Submissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a submission",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.litmushiring.com/api/v1/submissions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The submission identifier."
              }
            ]
          },
          "docs": "Fetch a single submission record by its identifier."
        }
      ]
    }
  ],
  "bundled": true
}